<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>TowerArchers</AssemblyName>
    <RootNamespace>TowerArchers</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Unity assemblies reference a newer netstandard than net462. The game supplies it at runtime. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <!-- VALHEIM_INSTALL is an MSBuild property or an environment variable. -->
    <!-- A client install uses valheim_Data. A dedicated server uses valheim_server_Data. -->
    <ValheimManaged Condition="Exists('$(VALHEIM_INSTALL)/valheim_Data/Managed')">$(VALHEIM_INSTALL)/valheim_Data/Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' And Exists('$(VALHEIM_INSTALL)/valheim_server_Data/Managed')">$(VALHEIM_INSTALL)/valheim_server_Data/Managed</ValheimManaged>
  </PropertyGroup>

  <Target Name="RequireValheimAssemblies" BeforeTargets="ResolveAssemblyReferences" Condition="'$(ValheimManaged)' == ''">
    <Error Text="Set VALHEIM_INSTALL to a Valheim client or dedicated server folder, or run: make fetch build" />
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <!-- Exclude the build assets: their publicizer task would conflict with the one above. -->
    <PackageReference Include="JotunnLib" Version="2.30.2" ExcludeAssets="build;runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true" HintPath="$(ValheimManaged)/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)/assembly_utils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ValheimManaged)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ValheimManaged)/UnityEngine.AssetBundleModule.dll" Private="false" />
  </ItemGroup>

  <!-- Deploys the DLL when VALHEIM_INSTALL is set. -->
  <Target Name="DeployToValheim" AfterTargets="Build" Condition="'$(VALHEIM_INSTALL)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(VALHEIM_INSTALL)/BepInEx/plugins/TowerArchers/" />
  </Target>

</Project>
